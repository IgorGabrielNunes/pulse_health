generator client {
  provider            = "prisma-client"
  output              = "../src/generated/prisma"
  moduleFormat        = "esm"
  importFileExtension = "js"
}

datasource db {
  provider = "postgresql"
}

enum ServiceStatus {
  PENDING
  UP
  DEGRADED
  DOWN
}

enum HttpMethod {
  GET
  HEAD
}

model Application {
  id                   String        @id @default(uuid(7)) @db.Uuid
  name                 String        @db.VarChar(80)
  url                  String        @db.VarChar(2048)
  method               HttpMethod    @default(GET)
  expectedStatus       Int           @default(200) @map("expected_status") @db.SmallInt
  checkIntervalSeconds Int           @default(60) @map("check_interval_seconds")
  timeoutMs            Int           @default(10000) @map("timeout_ms")
  degradedThresholdMs  Int           @default(1500) @map("degraded_threshold_ms")
  paused               Boolean       @default(false)
  status               ServiceStatus @default(PENDING)
  lastLatencyMs        Int?          @map("last_latency_ms")
  lastCheckedAt        DateTime?     @map("last_checked_at") @db.Timestamptz(3)
  nextCheckAt          DateTime      @default(now()) @map("next_check_at") @db.Timestamptz(3)
  createdAt            DateTime      @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt            DateTime      @updatedAt @map("updated_at") @db.Timestamptz(3)

  checks HealthCheck[]

  @@index([paused, nextCheckAt])
  @@map("applications")
}

model HealthCheck {
  id            BigInt        @id @default(autoincrement())
  applicationId String        @map("application_id") @db.Uuid
  status        ServiceStatus
  statusCode    Int?          @map("status_code") @db.SmallInt
  latencyMs     Int           @map("latency_ms")
  error         String?       @db.VarChar(500)
  checkedAt     DateTime      @default(now()) @map("checked_at") @db.Timestamptz(3)

  application Application @relation(fields: [applicationId], references: [id], onDelete: Cascade)

  @@index([applicationId, checkedAt(sort: Desc)])
  @@index([checkedAt])
  @@map("health_checks")
}

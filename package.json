{
  "name": "pulse",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/*"
  ],
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "dev:api": "npm run dev -w @pulse/api",
    "dev:web": "npm run dev -w @pulse/web",
    "codegen": "npm run codegen -w @pulse/api && npm run codegen -w @pulse/web",
    "typecheck": "npm run typecheck --workspaces",
    "build": "npm run build --workspaces"
  }
}
